{
  "name": "sprite-sheet-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev": "concurrently -k -n server,vite -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "pnpm test:server && pnpm test:client",
    "test:server": "tsx --import ./server/test-setup.ts --test server/*.test.ts",
    "test:client": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.0",
    "floating-vue": "^5.2.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "vue": "^3.5.42",
    "vue-final-modal": "^4.5.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
